% MACROS LUA

% LUA PATH
\begin{luacode*}
  -- Añado mi directorio al path
  package.path = "./?.lua;" .. package.path

  -- Cargo mi proyecto
  fEsfera = require("lua/funciones_esfera")
  
\end{luacode*}

\directlua{
  % Variable global para los datos actuales
  escenarioActivo = {}

  % Función global de interfaz para cambiar de datos
  function carga_escenario(fichero)
      escenarioActivo = dofile(fichero)
  end
}


% DEFINICIÓN DE COMANDOS

% --- COMANDOS LATEX LIMPIOS ---
\newcommand{\cargaDatos}[1]{%
  \directlua{carga_escenario("#1")}
}


% \dibujaEsferaCompleta
\newcommand{\dibujaTikzEsfera}[1][false]{%
  \directlua{fEsfera.dibuja_tikzesfera(#1, escenarioActivo)}
}


